{
  "ConnectionStrings": {
    "Investments": "Data Source=inverflex.db",
    "Redis": "localhost:6379"
  },
  "Redis": {
    "Endpoint": "localhost:6379",
    "Password": "REPLACE_WITH_REDIS_PASSWORD_IN_PRODUCTION",
    "Ssl": false,
    "AbortOnConnectFail": true,
    "ConnectTimeout": 5000,
    "SyncTimeout": 5000
  },
  "Jwt": {
    "Issuer": "InverFlex",
    "Audience": "InverFlex.Clients",
    "SigningKey": "REPLACE_WITH_ENV_VAR_IN_PRODUCTION"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
